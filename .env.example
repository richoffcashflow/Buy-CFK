# New Vercel project origin. Never use the existing app's origin for this project.
APP_URL=
CFK_MINT=3Rcko4DWwbLQP6vZ2Juxy3gDbv3omNkeg5np17fbpump
DATABASE_URL=
# The native Supabase/Vercel integration can supply POSTGRES_URL instead.
CRON_SECRET=

# Privy: enable Solana embedded wallets, Telegram seamless login, and allowed app domains.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
TELEGRAM_BOT_USERNAME=cashflowkeybot
# Server-only bot token. Also configure the bot in the Privy dashboard for Telegram login.
TELEGRAM_BOT_TOKEN=
SOLANA_RPC_URL=
# PumpPortal Local Transaction API constructs trades; Privy signs in the background.
BIRDEYE_API_KEY=
TRADING_ENABLED=false

# 15% is enforced in server/core.mjs for both directions.
# Do not enable until an approved provider adapter passes the contract tests.
RAMP_ENABLED=false
RAMP_PROVIDER_NAME=
RAMP_ADAPTER_URL=
RAMP_ADAPTER_KEY=
RAMP_WEBHOOK_SECRET=
RAMP_ALLOWED_ORIGINS=

# Stripe web onramp credentials, from the same account and mode.
# These are API keys, not the mobile embedded-component client credentials.
# The secret stays on the server; never use a VITE_ or NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret for /api/stripe/webhook (onramp session notifications).
STRIPE_ONRAMP_WEBHOOK_SECRET=
STRIPE_ONRAMP_ENABLED=false
# Public Solana address of the admin Privy wallet. Never a private key.
PLATFORM_FEE_WALLET=

# Google / YouTube browser measurement.
GOOGLE_TAG_ID=
GOOGLE_ADS_ID=
GOOGLE_VIEW_CONVERSION=
GOOGLE_CHECKOUT_CONVERSION=
GOOGLE_PURCHASE_CONVERSION=
# Authoritative server Purchase upload; configure only one primary Google Ads purchase action.
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=v22
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

META_PIXEL_ID=
META_ACCESS_TOKEN=
META_API_VERSION=v23.0
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
X_PIXEL_ID=
X_VIEW_EVENT_ID=
X_CHECKOUT_EVENT_ID=
X_PURCHASE_EVENT_ID=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
