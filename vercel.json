{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}],
  "rewrites": [{"source":"/api/:path*","destination":"/api/index?route=:path*"},{"source":"/((?!api/|assets/).*)","destination":"/index.html"}],
  "crons": [{"path":"/api/jobs","schedule":"*/5 * * * *"}]
}
